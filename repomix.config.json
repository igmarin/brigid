{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "git": {
      "sortByChanges": true
    }
  },
  "include": [
    "src/**",
    "crates/**",
    "tests/**",
    "benches/**",
    "Cargo.toml",
    "README.md",
    "docs/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".git",
      ".idea",
      ".cursor",
      ".claude",
      ".grok",
      ".zed",
      ".codegraph",
      "graphify-out",
      "repomix-output.xml",
      "repomix-output.md",
      "coverage",
      "review-result.txt",
      "rs-guard-metrics.json",
      "*.gem",
      ".DS_Store",
      "target/",
      "*.sha256",
      "*.pdb",
      "mutants.out*/"
    ]
  }
}
